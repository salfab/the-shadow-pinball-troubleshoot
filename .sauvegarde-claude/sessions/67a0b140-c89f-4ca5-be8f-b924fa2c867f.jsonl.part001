Sol 1–16)."," - [ ] BR3, C8/R260, porte-fusibles ; embases (broches, soudures fissurées) ; ponts de soudure."]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"b695c2fe-30a9-4705-a7ac-d7402526088b","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"67a0b140-c89f-4ca5-be8f-b924fa2c867f","userType":"external","entrypoint":"cli","cwd":"C:\\sources\\the-shadow-pinball-troubleshoot","sessionId":"67a0b140-c89f-4ca5-be8f-b924fa2c867f","version":"2.1.310","gitBranch":"HEAD","slug":"golden-gathering-hearth"}
