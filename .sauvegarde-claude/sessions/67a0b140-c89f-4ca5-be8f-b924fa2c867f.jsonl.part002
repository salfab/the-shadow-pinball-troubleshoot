a5-f491-4ec0-b2d3-9e5b8de75949","permissionDecision":{"decision":"accept","source":"config","reasonType":"mode"},"session_id":"67a0b140-c89f-4ca5-be8f-b924fa2c867f","userType":"external","entrypoint":"cli","cwd":"C:\\sources\\the-shadow-pinball-troubleshoot","sessionId":"67a0b140-c89f-4ca5-be8f-b924fa2c867f","version":"2.1.310","gitBranch":"HEAD","slug":"golden-gathering-hearth"}
